<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 小部件：今日屏幕 + 专注时长（拿起次数收进头部）
     兼容性约束（2026-10-25 实测踩坑，Android 17 / ColorOS）：
     1. 布局在桌面启动器进程里 inflate，那里有 View 类白名单，
        **普通 <View> 会抛 "Class not allowed to be inflated" 直接导致
        「载入窗口小部件时出现问题」**——分隔线一律用 ImageView + background；
     2. 仅用 RemoteViews 官方支持的 View：LinearLayout / TextView / ImageView；
     3. 不用 previewLayout、不用主题属性样式、只用 API 1 就有的属性。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="「留白」"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#8A8272" />

        <TextView
            android:id="@+id/widget_pickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="拿起 0"
            android:textSize="10sp"
            android:textColor="#6E675C" />
    </LinearLayout>

    <!-- 今日屏幕：第一行小时、第二行分钟（RemoteViews 白名单内控件） -->
    <LinearLayout
        android:id="@+id/widget_screen_hours_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_screen_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B1915" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="小时"
            android:textSize="11sp"
            android:textColor="#6E675C" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_screen_minutes_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_screen_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B1915" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="分"
            android:textSize="11sp"
            android:textColor="#6E675C" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日屏幕"
        android:textSize="10sp"
        android:textColor="#6E675C" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="#E6E1D6" />

    <TextView
        android:id="@+id/widget_focus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="专注 0 分钟"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#0A7A61" />
</LinearLayout>
