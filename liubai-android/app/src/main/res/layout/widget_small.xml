<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 小部件：今日屏幕 + 专注时长（拿起次数收进头部）
     兼容性约束：仅用 RemoteViews 官方支持的 View 与 API 1 属性，不依赖启动器主题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="「留白」"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#8A8272" />

        <TextView
            android:id="@+id/widget_pickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="拿起 0"
            android:textSize="10sp"
            android:textColor="#6E675C" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 分钟"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1B1915" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日屏幕"
        android:textSize="10sp"
        android:textColor="#6E675C" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="#E6E1D6" />

    <TextView
        android:id="@+id/widget_focus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="专注 0 分钟"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#0A7A61" />
</LinearLayout>
